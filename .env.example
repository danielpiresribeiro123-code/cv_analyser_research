# ==================================================
# PROJECT ROOT
# Absolute path to the project root directory
# ==================================================
PROJECT_ROOT="C:/path/to/your/CapStone"


# ==================================================
# DATASETS (outside the project)
# Directories containing training datasets
# ==================================================
#DATASETS_ROOT="C:/path/to/your/datasets"
#DATASETS_SKILL_TABLE="C:/path/to/your/datasets/Skill_tables"

# Optional additional datasets
# Example:
# DATA_EXAMPLE_ROOT="C:/path/to/another/dataset"


# ==================================================
# MODELS (inside the project)
# Directory where trained models are stored
# ==================================================
MODELS_IN_ROOT="${PROJECT_ROOT}/models"


# ==================================================
# MODELS (outside the project) — optional
# Uncomment if you want to store models outside the repository
# ==================================================
MODELS_OUT_ROOT="C:/path/to/external/models"


# ==================================================
# OPTIONAL TOOLS
# Example: explicit Git executable path (only if not in system PATH)
# ==================================================
# GIT_EXE="C:/Program Files/Git/cmd/git.exe"


# ==================================================
# ENVIRONMENT
# Possible values: dev | test | prod
# ==================================================
ENV="dev"
