data/*
!data/README.md

# =========================
# Models
# =========================

# Ignore common weight formats elsewhere
*.pt
*.pth
*.onnx
*.ckpt
*.bin

# Ignore everything inside train_yolo
src/train_yolo/*

# Keep only source code and configs
!src/train_yolo/functions/
!src/train_yolo/functions/**

!src/train_yolo/data_yaml_used/
!src/train_yolo/data_yaml_used/**


# Ignore everything inside models
models/*

# BUT keep trained models
!models/trained/
!models/trained/**




# =========================
# Build / distribution
# =========================
build/
dist/
*.egg-info/

# =========================
# Local configs
# =========================
config/*.local.*


# =========================
# Python cache
# =========================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so