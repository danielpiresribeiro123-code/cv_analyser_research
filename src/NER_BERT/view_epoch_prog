import json
import matplotlib.pyplot as plt
import os

caminho_ficheiro = r"data\processed\results_ner_lowercase\checkpoint-2490\trainer_state.json"

def visualizar_e_guardar_metricas():
    if not os.path.exists(caminho_ficheiro):
        print(f"Erro: Ficheiro nao encontrado em {caminho_ficheiro}")
        return

    with open(caminho_ficheiro, "r", encoding="utf-8") as f:
        dados = json.load(f)

    historico = dados["log_history"]
    
    e_eval = [reg["epoch"] for reg in historico if "eval_f1" in reg]
    f1 = [reg["eval_f1"] for reg in historico if "eval_f1" in reg]
    prec = [reg["eval_precision"] for reg in historico if "eval_f1" in reg]
    rec = [reg["eval_recall"] for reg in historico if "eval_f1" in reg]
    
    passos_loss = [reg["step"] for reg in historico if "loss" in reg]
    valores_loss = [reg["loss"] for reg in historico if "loss" in reg]

    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(16, 6))

    ax1.plot(e_eval, f1, "g-o", label="F1-Score", linewidth=2.5)
    ax1.plot(e_eval, prec, "b--", label="Precision", alpha=0.7)
    ax1.plot(e_eval, rec, "r--", label="Recall", alpha=0.7)
    ax1.set_title("Qualidade do Modelo por Epoca")
    ax1.set_xlabel("Epoca")
    ax1.set_ylabel("Score (0-1)")
    ax1.legend()
    ax1.grid(True, linestyle=':', alpha=0.6)

    ax2.plot(passos_loss, valores_loss, color="orange", label="Loss")
    ax2.set_title("Curva de Aprendizagem (Erro)")
    ax2.set_xlabel("Passos de Treino")
    ax2.set_ylabel("Loss")
    ax2.legend()
    ax2.grid(True, linestyle=':', alpha=0.6)

    plt.tight_layout()
    
    nome_arquivo = "metricas_finais_checkpoint_2490.png"
    plt.savefig(nome_arquivo, dpi=300, format="png")
    plt.close() # Liberta a memoria sem abrir janela
    print(f"Sucesso! Grafico guardado como: {nome_arquivo}")

if __name__ == "__main__":
    visualizar_e_guardar_metricas()